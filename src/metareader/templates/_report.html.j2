{#- Reproduction report. Context: see report.write_report. Figures and files are linked by package-relative path. -#}
{%- macro trunc(s, n) -%}{{ s[:n - 1] ~ "…" if s and s|length > n else (s or "") }}{%- endmacro -%}
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>Reproduction report: {{ title }}</title>
<style>
body{font:15px/1.5 Georgia,serif;max-width:1100px;margin:2em auto;padding:0 1.5em;color:#1d1d1b}
h1{font-size:1.6em;line-height:1.25}h2{font-family:system-ui,sans-serif;border-bottom:1px solid #ddd;padding-bottom:.2em;margin-top:2em}
table{border-collapse:collapse;width:100%;font:13px system-ui,sans-serif;margin:.5em 0}th,td{border:1px solid #ddd;padding:4px 6px;vertical-align:top;text-align:left}th{background:#f3f3ef}
code{font-size:12px}.hash{font-size:10px;color:#777;word-break:break-all}.quote{color:#666;font-style:italic;font-size:12px;margin-top:2px}
.summary{display:flex;gap:10px;flex-wrap:wrap;font:14px system-ui,sans-serif}.summary div{padding:8px 12px;border-radius:6px;background:#f3f3ef}
.st{white-space:nowrap;font-weight:600}.st-match{color:#2e7d32}.st-within{color:#b58900}.st-deviation{color:#c62828}.st-missing{color:#757575}.st-figure{color:#1565c0}.st-unparsable{color:#6a1b9a}
.cells td{font-size:11px;text-align:right}.cells td.st-match{background:#e8f5e9}.cells td.st-within{background:#fff8e1}.cells td.st-deviation,.cells td.st-missing,.cells td.st-unparsable{background:#ffebee}
.figs{display:grid;grid-template-columns:1fr 1fr;gap:12px}.figs img{max-width:100%;border:1px solid #ddd}.figs figure{margin:0}
.dagwrap{border:1px solid #ddd;padding:6px}.dagwrap svg{max-width:100%;height:auto}
.trace{font-size:12px;margin:2px 0 0}.trace summary{cursor:pointer;color:#2a5aa0}.trace ul{margin:2px 0 4px;padding-left:1.2em}.trace h4{margin:6px 0 0;font-size:12px}.warn{color:#b3261e}
.legend span{display:inline-block;padding:1px 6px;border-radius:3px;color:#fff;font:11px system-ui;margin-right:4px}
</style></head><body>
<h1>Computational reproduction report<br><small>{{ title }}</small></h1>
<p>{{ authors }}{% if authors %}<br>{% endif %}
{% for k, v in identifiers.items() %}{{ k }}: {% if k == "doi" %}<a href="https://doi.org/{{ v }}">{{ v }}</a>{% else %}{{ v }}{% endif %}{{ " · " if not loop.last }}{% endfor %}<br>
Report generated {{ generated_at }} by MetaReader.</p>

<h2>Summary</h2>
<div class="summary">
<div><b>{{ reproduced }}/{{ numeric }}</b> non-figure results reproduced (match or within {{ settings.threshold }} %)</div>
{% for k, v in cmp.summary.items() %}<div class="st-{{ k }}">{{ labels[k] }}: <b>{{ v }}</b></div>{% endfor %}
</div>
<p>Comparison: rounding {{ "as reported in the paper" if settings.rounding == "reported" else settings.rounding ~ " decimals" }}; deviations above {{ settings.threshold }} % are flagged.
Pipeline: {{ tpl.label }}, <code>{{ tpl.command }}</code>{% if run %}, last run {{ run.status }} (exit {{ run.exit_code }}, {{ "%.1f"|format((run.duration_ms or 0) / 1000) }} s, {{ run.created_at }}){% else %} (not run through MetaReader){% endif %}.
{% if codegen %}Code generated by agent profile <code>{{ codegen.profile }}</code> (model {{ codegen.request.model or "default" }}, job {{ codegen.id }}, {{ codegen.status }}{% if codegen.result %}, {{ codegen.result.todo.remaining }} TODO markers left{% endif %}).{% endif %}</p>
{% if cmp.output_errors %}<p class="warn"><b>outputs/results.json does not have the required format:</b><br>{% for e in cmp.output_errors %}{{ e }}<br>{% endfor %}</p>{% else %}<p>outputs/results.json has the required format.</p>{% endif %}
{% if cmp.output_warnings %}<details><summary>{{ cmp.output_warnings|length }} coverage warning(s)</summary><p>{% for e in cmp.output_warnings %}{{ e }}<br>{% endfor %}</p></details>{% endif %}
<p>Package validation: {% if validation.valid %}passed{% else %}<span class="warn">{{ validation.errors|length }} error(s)</span>{% endif %}{% if validation.warnings %}, {{ validation.warnings|length }} warning(s){% endif %}.</p>

<h2>Results comparison</h2>
<table><tr><th>ID</th><th>Result</th><th>Reported</th><th>Reproduced</th><th>Deviation</th><th>Status</th></tr>
{% for r in cmp.rows %}{% set t = targets[r.target] %}
<tr><td><b>{{ r.target }}</b></td><td>{{ r.description }}{% if t.quote %}<div class="quote">“{{ trunc(t.quote, 300) }}”</div>{% endif %}{% if r.note %}<div class="quote">Note: {{ r.note }}</div>{% endif %}
{% set tr = traces[r.target] %}<details class="trace"><summary>Provenance</summary>
{% if tr.passage %}<h4>Text</h4><ul>{% for p in tr.passage %}<li><code>{{ p.extraction }} {{ p.id }}</code> “{{ trunc(p.text, 400) }}”</li>{% endfor %}</ul>{% elif t.unreferenced %}<h4>Text</h4><p>Not from the paper's text: {{ t.note }}</p>{% endif %}
{% if tr.step %}<h4>Procedure</h4><ul>{% for s in tr.step %}<li><b>{{ s.id }}</b> [{{ s.kind }}] {{ s.summary }}</li>{% endfor %}</ul>{% endif %}
{% if tr.data %}<h4>Data files</h4><ul>{% for d in tr.data %}<li><code>{{ d.path }}</code></li>{% endfor %}</ul>{% endif %}
{% if tr.extraction or tr.fulltext or tr.paper %}<h4>Sources</h4><ul>{% for e in tr.extraction %}<li>extraction <code>{{ e.path }}</code> ({{ e.method }})</li>{% endfor %}{% for f in tr.fulltext %}<li>full text <code>{{ f.path }}</code> ({{ f.origin }})</li>{% endfor %}{% for p in tr.paper %}<li>{{ p.identifier }}</li>{% endfor %}</ul>{% endif %}
<p><a href="#provenance" onclick="focusNode('t:{{ r.target }}')">Show in the diagram</a></p>
</details></td>
<td>{{ r.expected_text }}</td><td>{{ r.reproduced_text }}</td><td>{{ "%.2f %%"|format(r.deviation) if r.deviation is not none else "" }}</td><td class="st st-{{ r.status }}">{{ labels[r.status] }}</td></tr>
{% if r.cells %}<tr><td colspan="6"><details><summary>Cell comparison</summary><table class="cells">
{% for row in r.cells %}<tr>{% for c in row %}<td class="st-{{ c.status }}" title="expected {{ c.expected }}{% if c.deviation is not none %}, deviation {{ "%.2f"|format(c.deviation) }} %{% endif %}">{{ c.reproduced }}<br><small>{{ c.expected }}</small></td>{% endfor %}</tr>{% endfor %}
</table></details></td></tr>{% endif %}
{% if r.target in figures %}{% set f = figures[r.target] %}<tr><td colspan="6"><div class="figs">
<figure><figcaption>Original</figcaption>{% if f.original %}<img src="{{ f.original }}" alt="original {{ r.target }}">{% else %}<em>not available</em>{% endif %}</figure>
<figure><figcaption>Reproduced</figcaption>{% if f.reproduced %}<img src="{{ f.reproduced }}" alt="reproduced {{ r.target }}">{% else %}<em>not produced</em>{% endif %}</figure>
</div></td></tr>{% endif %}
{% endfor %}</table>

<h2 id="provenance">Result provenance</h2>
<p>From the paper and the input files (top) to the targets (bottom). Click a node to highlight everything it was made from and everything made from it; click it again to clear. Dashed lines: text a step or target refers to.</p>
<p class="legend">{% for k in ["paper", "fulltext", "data", "extraction", "passage", "step"] %}<span style="background:{{ colors[k] }}">{{ k }}</span>{% endfor %}{% for s in ["match", "within", "deviation", "missing", "figure"] %}<span style="background:{{ colors[s] }}">{{ s }}</span>{% endfor %}</p>
<div class="dagwrap">{{ svg|safe }}</div>
<script type="application/json" id="lineage">{{ lineage|tojson }}</script>
<script>
const lineage = JSON.parse(document.getElementById("lineage").textContent);
const dag = document.querySelector(".dag");
let selected = null;
function focusNode(id) {
  dag.querySelectorAll(".on, .sel").forEach((e) => e.classList.remove("on", "sel"));
  if (selected === id || !id) { selected = null; dag.classList.remove("focus"); return; }
  selected = id;
  const keep = new Set([id, ...(lineage[id] || [])]);
  dag.classList.add("focus");
  dag.querySelectorAll(".node").forEach((g) => { if (keep.has(g.dataset.node)) g.classList.add("on"); if (g.dataset.node === id) g.classList.add("sel"); });
  dag.querySelectorAll("path").forEach((p) => { if (keep.has(p.dataset.from) && keep.has(p.dataset.to)) p.classList.add("on"); });
}
dag.querySelectorAll(".node").forEach((g) => g.addEventListener("click", () => focusNode(g.dataset.node)));
</script>

<h2>Sources</h2>
<table><tr><th>Full text</th><th>Format</th><th>Origin</th><th>SHA-256</th></tr>
{% for r in fulltexts %}<tr><td><code>{{ r.path }}</code></td><td>{{ r.metareader.flavor }}</td><td>{% set o = r.metareader.origin %}{% if o.type == "url" %}{{ o.label }}{% elif o.type == "conversion" %}{{ o.converter }} from {{ o.source }}{% else %}local file{% endif %}</td><td><code class="hash">{{ r.hash[7:] }}</code></td></tr>{% endfor %}
</table>
<table><tr><th>Extraction</th><th>Method</th><th>From</th></tr>
{% for r in extractions %}<tr><td><code>{{ r.path }}</code></td><td>{{ r.metareader.method }}{% if r.metareader.llm_call %} (LLM call {{ r.metareader.llm_call }}){% endif %}</td><td>{{ r.metareader.fulltexts|join(", ") }}</td></tr>{% endfor %}
</table>
{% if llm_runs %}<table><tr><th>LLM extraction</th><th>Profile / model / effort</th><th>Accepted</th><th>Rejected</th></tr>
{% for x in llm_runs %}<tr><td>{{ x.kind }} {{ x.id }}{% if x.disabled %} (disabled){% endif %}</td><td>{{ x.profile }} / {{ x.model or "default" }} / {{ x.effort or "default" }}</td><td>{{ x.entries }}</td><td>{{ x.rejected }}</td></tr>{% endfor %}
</table>{% endif %}

<h2>Input files</h2>
<table><tr><th>File</th><th>Role</th><th>Used</th><th>Note</th><th>Size</th><th>SHA-256</th></tr>
{% for r in inputs %}<tr><td><code>{{ r.path }}</code></td><td>{{ r.metareader.role }}</td><td>{{ "yes" if r.metareader.used else "no" }}</td><td>{{ r.metareader.note }}</td><td>{{ "%.1f KB"|format(r.bytes / 1024) }}</td><td><code class="hash">{{ r.hash[7:] }}</code></td></tr>
{% else %}<tr><td colspan="6">none</td></tr>{% endfor %}
</table>

<h2>Analysis plan</h2>
<table><tr><th>Step</th><th>Kind</th><th>Summary and source quote</th><th>Depends on</th><th>Produces</th></tr>
{% for s in plan.steps %}<tr><td><b>{{ s.id }}</b></td><td>{{ s.kind }}</td><td>{{ s.summary }}{% if s.quote %}<div class="quote">“{{ s.quote }}”</div>{% endif %}{% if s.inputs %}<div><code>{{ s.inputs|join(", ") }}</code></div>{% endif %}</td><td>{{ s.depends_on|join(", ") }}</td><td>{{ trunc(s.produces|join(", "), 120) }}</td></tr>{% endfor %}
</table>

<h2>Package contents</h2>
<p>Every file of the package with its SHA-256 (<code>datapackage.json</code>, a Frictionless Data Package). Re-run with <code>{{ tpl.command }}</code>.</p>
<table><tr><th>Path</th><th>Kind</th><th>Size</th><th>SHA-256</th></tr>
{% for r in resources %}<tr><td><code>{{ r.path }}</code></td><td>{{ r.metareader.kind }}</td><td>{{ "%.1f KB"|format(r.bytes / 1024) }}</td><td><code class="hash">{{ r.hash[7:] }}</code></td></tr>{% endfor %}
</table>
</body></html>
