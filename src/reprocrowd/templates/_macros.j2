{#- Shared pieces of all master-script templates. -#}
{% macro header(paper, tpl, marker) -%}
# Reproduction of: {{ paper.title or "(untitled)" }}
{% for k, v in paper.identifiers.items() %}# {{ k }}: {{ v }}
{% endfor -%}
# Generated by ReproCrowd ({{ tpl.label }}). Every {{ marker }} block must be implemented; remove the marker when done.
# Targets: results_schema.json · Plan: analysis_plan.json · Output: outputs/results.json
# (format: schemas/results-output.schema.json)
{%- endmacro %}

{% macro step_header(s, indent="") -%}
{% set c = indent ~ "# " -%}
{{ c }}==== {{ s.id }} [{{ s.kind }}]: {{ s.summary.split("\n")[0] | truncate(80, true, "…", 0) }} ====
{% if s.summary | length > 80 or "\n" in s.summary %}{{ c }}Summary:
{% for line in (s.summary | wordwrap(88, true, "\n")).split("\n") %}{{ c }}  {{ line }}
{% endfor %}{% endif -%}
{% if s.quote %}{{ c }}Source quote:
{% for line in (('"' ~ s.quote ~ '"') | wordwrap(88, true, "\n")).split("\n") %}{{ c }}  {{ line }}
{% endfor %}{% endif -%}
{% if s.inputs %}{{ c }}Inputs: {{ s.inputs | join(", ") }}
{% endif -%}
{{ c }}Depends on: {{ s.depends_on | join(", ") or "—" }}
{% if s.produces %}{{ c }}Produces: {{ s.produces | join(", ") }}
{% endif -%}
{%- endmacro %}
