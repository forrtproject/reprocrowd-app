# Writes outputs/results.json at full precision: jsonlite rounds to 4 decimals unless digits = NA.
write_reprocrowd_results <- function(results, path = "outputs/results.json") {
  dir.create(dirname(path), recursive = TRUE, showWarnings = FALSE)
  jsonlite::write_json(list(results = results), path, auto_unbox = TRUE, digits = NA, pretty = TRUE)
  invisible(path)
}
