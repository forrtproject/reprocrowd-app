{#- Shared pieces of all master-script templates. Every value from the package goes through `oneline` (one-line
    values) or `nl` (text split into comment lines): a line break that isn't followed by the comment marker would make
    the rest of the value code. -#}
{% macro header(paper, tpl, marker) -%}
# Reproduction of: {{ (paper.title or "(untitled)") | oneline }}
{% for k, v in paper.identifiers.items() %}# {{ k | oneline }}: {{ v | oneline }}
{% endfor -%}
# Generated by ReproCrowd ({{ tpl.label }}). Every {{ marker }} block must be implemented; remove the marker when done.
# Targets: results_schema.json · Plan: analysis_plan.json · Output: outputs/results.json
# (format: schemas/results-output.schema.json)
{%- endmacro %}

{% macro step_header(s, indent="") -%}
{% set c = indent ~ "# " -%}
{% set summary = s.summary | nl -%}
{{ c }}==== {{ s.id | oneline }} [{{ s.kind | oneline }}]: {{ summary.split("\n")[0] | truncate(80, true, "…", 0) }} ====
{% if summary | length > 80 or "\n" in summary %}{{ c }}Summary:
{% for line in (summary | wordwrap(88, true, "\n")).split("\n") %}{{ c }}  {{ line }}
{% endfor %}{% endif -%}
{% if s.refs %}{{ c }}Source text:
{% for r in s.refs %}{% for line in (("[" ~ r.id ~ "] " ~ passage_text(r)) | nl | wordwrap(88, true, "\n")).split("\n") %}{{ c }}  {{ line }}
{% endfor %}{% endfor %}{% endif -%}
{% if s.note %}{{ c }}Note:
{% for line in (s.note | nl | wordwrap(88, true, "\n")).split("\n") %}{{ c }}  {{ line }}
{% endfor %}{% endif -%}
{% if s.inputs %}{{ c }}Inputs: {{ s.inputs | map("oneline") | join(", ") }}
{% endif -%}
{{ c }}Depends on: {{ s.depends_on | map("oneline") | join(", ") or "—" }}
{% if s.produces %}{{ c }}Produces: {{ s.produces | map("oneline") | join(", ") }}
{% endif -%}
{%- endmacro %}
