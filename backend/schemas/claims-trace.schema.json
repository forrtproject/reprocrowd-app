{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reprocrowd.example/schemas/claims-trace.schema.json",
  "title": "ClaimsTrace (claims_trace.json (written with the report and the archive; also GET …/claims:trace))",
  "$defs": {
    "ClaimResult": {
      "additionalProperties": false,
      "description": "A claim's result from the comparison: every evidence value of the claim and its sub-claims pooled.",
      "properties": {
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "reproduced",
            "partly",
            "not_reproduced",
            "not_computed"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "matched": {
          "title": "Matched",
          "type": "integer"
        },
        "tested": {
          "title": "Tested",
          "type": "integer"
        },
        "by_sub_claim": {
          "description": "results of the sub-claims, beside the pooled one",
          "items": {
            "$ref": "#/$defs/SubClaimResult"
          },
          "title": "By Sub Claim",
          "type": "array"
        },
        "evidence": {
          "description": "the claim's own evidence (an atomic claim's)",
          "items": {
            "$ref": "#/$defs/EvidenceResult"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "claim",
        "verdict",
        "matched",
        "tested",
        "by_sub_claim",
        "evidence"
      ],
      "title": "ClaimResult",
      "type": "object"
    },
    "ClaimTrace": {
      "additionalProperties": false,
      "description": "A broad claim in the user's trace format, with ids, mode, links, methods, flagged assumptions and its result.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the paper's DOI",
          "title": "Id"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the paper's title",
          "title": "Title"
        },
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "main_claim": {
          "title": "Main Claim",
          "type": "string"
        },
        "mode": {
          "enum": [
            "quote",
            "paraphrase"
          ],
          "title": "Mode",
          "type": "string"
        },
        "original_quote": {
          "title": "Original Quote",
          "type": "string"
        },
        "testable": {
          "title": "Testable",
          "type": "boolean"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "traced_under": {
          "items": {
            "type": "string"
          },
          "title": "Traced Under",
          "type": "array"
        },
        "sub_claims": {
          "items": {
            "$ref": "#/$defs/TraceSubClaim"
          },
          "title": "Sub Claims",
          "type": "array"
        },
        "quantitative_evidence": {
          "description": "an atomic claim's own evidence",
          "items": {
            "$ref": "#/$defs/TraceEvidence"
          },
          "title": "Quantitative Evidence",
          "type": "array"
        },
        "methods": {
          "items": {
            "$ref": "#/$defs/TraceMethod"
          },
          "title": "Methods",
          "type": "array"
        },
        "assumptions": {
          "description": "the coding agent's `# ASSUMPTION:` comments in the claim's file and the prepare file",
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "status": {
          "enum": [
            "review",
            "ready",
            "running",
            "reproduced",
            "partly",
            "not_reproduced",
            "not_computed",
            "not_testable"
          ],
          "title": "Status",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClaimResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the last run's result; absent when the claim has not run"
        }
      },
      "required": [
        "claim_id",
        "main_claim",
        "mode",
        "original_quote",
        "testable",
        "depends_on",
        "traced_under",
        "sub_claims",
        "quantitative_evidence",
        "methods",
        "assumptions",
        "status"
      ],
      "title": "ClaimTrace",
      "type": "object"
    },
    "EvidenceResult": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "title": "Target",
          "type": "string"
        },
        "status": {
          "enum": [
            "match",
            "within",
            "deviation",
            "missing",
            "figure",
            "unparsable"
          ],
          "title": "Status",
          "type": "string"
        },
        "expected_text": {
          "title": "Expected Text",
          "type": "string"
        },
        "reproduced_text": {
          "title": "Reproduced Text",
          "type": "string"
        }
      },
      "required": [
        "target",
        "status",
        "expected_text",
        "reproduced_text"
      ],
      "title": "EvidenceResult",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "description": "Points at one sentence, figure or table of an extraction.",
      "properties": {
        "extraction": {
          "description": "resource name of the extraction, e.g. ex-grobid",
          "title": "Extraction",
          "type": "string"
        },
        "id": {
          "description": "sentence (sec3.p2.s1, fig1.s1), figure (fig1) or table (tab1) id in that extraction",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "extraction",
        "id"
      ],
      "title": "Ref",
      "type": "object"
    },
    "SkippedSentence": {
      "additionalProperties": false,
      "description": "A sentence the LLM considered and did not turn into a claim.",
      "properties": {
        "ref": {
          "$ref": "#/$defs/Ref"
        },
        "reason": {
          "enum": [
            "background",
            "study_design",
            "other"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "reason"
      ],
      "title": "SkippedSentence",
      "type": "object"
    },
    "SubClaimResult": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "reproduced",
            "partly",
            "not_reproduced",
            "not_computed"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "matched": {
          "description": "evidence values that match or are within tolerance",
          "title": "Matched",
          "type": "integer"
        },
        "tested": {
          "description": "evidence values that were computed (match, within or deviation)",
          "title": "Tested",
          "type": "integer"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceResult"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "verdict",
        "matched",
        "tested",
        "evidence"
      ],
      "title": "SubClaimResult",
      "type": "object"
    },
    "TraceEvidence": {
      "additionalProperties": false,
      "description": "One reported value. There is no per-value tolerance: values are compared with the package-wide rule.",
      "properties": {
        "id": {
          "description": "the target's id",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "description": "the target's description",
          "title": "Label",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the value as the paper reports it",
          "title": "Value"
        },
        "comparator": {
          "description": "how the paper states it: \"=\", \"<\", …",
          "title": "Comparator",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "decimals": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "decimals as printed",
          "title": "Decimals"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "readable location of the target's first reference (section, table, figure)",
          "title": "Source"
        }
      },
      "required": [
        "id",
        "label",
        "comparator"
      ],
      "title": "TraceEvidence",
      "type": "object"
    },
    "TraceMethod": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "id",
        "summary",
        "quote"
      ],
      "title": "TraceMethod",
      "type": "object"
    },
    "TracePaper": {
      "additionalProperties": false,
      "properties": {
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "title": "TracePaper",
      "type": "object"
    },
    "TraceSubClaim": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "id of the method in the claim's `methods`",
          "title": "Method"
        },
        "quantitative_evidence": {
          "items": {
            "$ref": "#/$defs/TraceEvidence"
          },
          "title": "Quantitative Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "claim",
        "quantitative_evidence"
      ],
      "title": "TraceSubClaim",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "claims_trace.json: every effective claim's trace, and the sentences the enabled claims run passed over.",
  "properties": {
    "paper": {
      "$ref": "#/$defs/TracePaper"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/ClaimTrace"
      },
      "title": "Claims",
      "type": "array"
    },
    "skipped": {
      "items": {
        "$ref": "#/$defs/SkippedSentence"
      },
      "title": "Skipped",
      "type": "array"
    }
  },
  "required": [
    "paper",
    "claims",
    "skipped"
  ],
  "type": "object"
}
