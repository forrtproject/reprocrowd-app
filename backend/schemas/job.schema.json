{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reprocrowd.example/schemas/job.schema.json",
  "title": "Job (jobs/<id>.json)",
  "$defs": {
    "CodegenResult": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "codegen",
          "default": "codegen",
          "title": "Type",
          "type": "string"
        },
        "commit_before": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "package git commit before the agent ran",
          "title": "Commit Before"
        },
        "commit_after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "commit of the agent's changes (null: nothing changed)",
          "title": "Commit After"
        },
        "changed_files": {
          "items": {
            "type": "string"
          },
          "title": "Changed Files",
          "type": "array"
        },
        "todo": {
          "$ref": "#/$defs/TodoStatus"
        },
        "git_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "why git was skipped, if it was",
          "title": "Git Note"
        }
      },
      "required": [
        "todo"
      ],
      "title": "CodegenResult",
      "type": "object"
    },
    "DeterminismCheck": {
      "additionalProperties": false,
      "description": "Outcome of running the master script twice and comparing outputs/results.json and produced output files.",
      "properties": {
        "runs": {
          "minimum": 2,
          "title": "Runs",
          "type": "integer"
        },
        "status": {
          "enum": [
            "identical",
            "numerically_close",
            "different",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "run1_results_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run1 Results Sha256"
        },
        "run2_results_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run2 Results Sha256"
        },
        "differences": {
          "items": {
            "$ref": "#/$defs/DeterminismDiff"
          },
          "title": "Differences",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "runs",
        "status",
        "summary"
      ],
      "title": "DeterminismCheck",
      "type": "object"
    },
    "DeterminismDiff": {
      "additionalProperties": false,
      "description": "One difference observed between two consecutive runs of the master script.",
      "properties": {
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "target id in outputs/results.json, if applicable",
          "title": "Target"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "package-relative output file path, if applicable",
          "title": "Path"
        },
        "kind": {
          "enum": [
            "missing_in_run",
            "value_changed",
            "table_changed",
            "file_changed",
            "parse_error"
          ],
          "title": "Kind",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "max_rel_diff": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "largest relative numeric change between runs, if numeric",
          "title": "Max Rel Diff"
        },
        "looks_like_clock": {
          "default": false,
          "description": "heuristic: the difference looks like a clock/timestamp reading",
          "title": "Looks Like Clock",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "detail"
      ],
      "title": "DeterminismDiff",
      "type": "object"
    },
    "FailureHint": {
      "additionalProperties": false,
      "description": "Actionable hint parsed from a failed run's log.",
      "properties": {
        "kind": {
          "enum": [
            "missing_package",
            "path",
            "network",
            "encoding",
            "session_state",
            "permission",
            "syntax",
            "memory"
          ],
          "title": "Kind",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "suggestion": {
          "title": "Suggestion",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "detail",
        "suggestion"
      ],
      "title": "FailureHint",
      "type": "object"
    },
    "RunIsolation": {
      "additionalProperties": false,
      "description": "Clean-room settings applied to the script run (honest record, not an OS container).",
      "properties": {
        "network_denied_by": {
          "description": "how network access was denied: Linux network namespace, macOS sandbox-exec, or dead-proxy env vars only",
          "enum": [
            "namespace",
            "sandbox",
            "proxy"
          ],
          "title": "Network Denied By",
          "type": "string"
        },
        "clean_home": {
          "default": true,
          "description": "private empty HOME/TMPDIR and scratch R library (user libraries stay readable)",
          "title": "Clean Home",
          "type": "boolean"
        },
        "tz": {
          "default": "UTC",
          "title": "Tz",
          "type": "string"
        },
        "locale": {
          "default": "C.UTF-8",
          "title": "Locale",
          "type": "string"
        },
        "runtime_caches": {
          "description": "runtime cache files left behind in the package by the run",
          "items": {
            "type": "string"
          },
          "title": "Runtime Caches",
          "type": "array"
        }
      },
      "required": [
        "network_denied_by"
      ],
      "title": "RunIsolation",
      "type": "object"
    },
    "RunResult": {
      "additionalProperties": false,
      "properties": {
        "commit_before": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "git commit of the package just before the run",
          "title": "Commit Before"
        },
        "snapshot": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "package path -> \"sha256:<hex>\" of the targets, plan, scripts/code and used inputs at launch; null for older runs",
          "title": "Snapshot"
        },
        "results_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "\"sha256:<hex>\" of outputs/results.json at finish; null if none was written",
          "title": "Results Sha256"
        },
        "log_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "\"sha256:<hex>\" of the complete run log at finish",
          "title": "Log Sha256"
        },
        "type": {
          "const": "run",
          "default": "run",
          "title": "Type",
          "type": "string"
        },
        "command": {
          "title": "Command",
          "type": "string"
        },
        "log": {
          "description": "package-relative path of the run log",
          "title": "Log",
          "type": "string"
        },
        "results_file": {
          "description": "outputs/results.json exists after the run",
          "title": "Results File",
          "type": "boolean"
        },
        "output_errors": {
          "description": "outputs/results.json problems (format, unknown ids)",
          "items": {
            "type": "string"
          },
          "title": "Output Errors",
          "type": "array"
        },
        "output_warnings": {
          "description": "coverage problems (targets missing from the output)",
          "items": {
            "type": "string"
          },
          "title": "Output Warnings",
          "type": "array"
        },
        "commit_after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit After"
        },
        "runs": {
          "default": 1,
          "description": "number of script runs requested (2 = determinism check)",
          "minimum": 1,
          "title": "Runs",
          "type": "integer"
        },
        "determinism": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeterminismCheck"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "two-run determinism check result when runs=2"
        },
        "isolation": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunIsolation"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "clean-room environment and network isolation applied to the run"
        },
        "failure_hints": {
          "description": "structured failure hints parsed from the run log when a run fails",
          "items": {
            "$ref": "#/$defs/FailureHint"
          },
          "title": "Failure Hints",
          "type": "array"
        }
      },
      "required": [
        "command",
        "log",
        "results_file"
      ],
      "title": "RunResult",
      "type": "object"
    },
    "TodoFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "remaining": {
          "title": "Remaining",
          "type": "integer"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/TodoLine"
          },
          "title": "Lines",
          "type": "array"
        }
      },
      "required": [
        "path",
        "remaining",
        "lines"
      ],
      "title": "TodoFile",
      "type": "object"
    },
    "TodoLine": {
      "additionalProperties": false,
      "properties": {
        "line": {
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "line",
        "text"
      ],
      "title": "TodoLine",
      "type": "object"
    },
    "TodoStatus": {
      "additionalProperties": false,
      "description": "Actionable TODO(LLM): markers left in the template's files. The header line that explains the marker\n(\"Every TODO(LLM) block must be implemented…\") is not counted: only the marker followed by a colon is.",
      "properties": {
        "remaining": {
          "title": "Remaining",
          "type": "integer"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/TodoFile"
          },
          "title": "Files",
          "type": "array"
        }
      },
      "required": [
        "remaining",
        "files"
      ],
      "title": "TodoStatus",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "jobs/<id>.json",
  "properties": {
    "id": {
      "pattern": "^job-[0-9a-z-]+$",
      "title": "Id",
      "type": "string"
    },
    "type": {
      "enum": [
        "codegen",
        "run"
      ],
      "title": "Type",
      "type": "string"
    },
    "status": {
      "enum": [
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "timeout",
        "interrupted"
      ],
      "title": "Status",
      "type": "string"
    },
    "profile": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "agent profile (codegen)",
      "title": "Profile"
    },
    "argv": {
      "description": "the command that runs (configured, never caller-supplied)",
      "items": {
        "type": "string"
      },
      "title": "Argv",
      "type": "array"
    },
    "request": {
      "additionalProperties": true,
      "title": "Request",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "duration_ms": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Ms"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Code"
    },
    "stdout": {
      "description": "package-relative path of the raw stdout",
      "title": "Stdout",
      "type": "string"
    },
    "stderr": {
      "title": "Stderr",
      "type": "string"
    },
    "events_format": {
      "enum": [
        "claude-stream-json",
        "opencode-json",
        "codex-json",
        "text"
      ],
      "title": "Events Format",
      "type": "string"
    },
    "result": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "codegen": "#/$defs/CodegenResult",
              "run": "#/$defs/RunResult"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CodegenResult"
            },
            {
              "$ref": "#/$defs/RunResult"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "id",
    "type",
    "status",
    "argv",
    "created_at",
    "stdout",
    "stderr",
    "events_format"
  ],
  "type": "object"
}
