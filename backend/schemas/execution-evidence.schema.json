{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reprocrowd.example/schemas/execution-evidence.schema.json",
  "title": "ExecutionEvidence (evidence/execution.json)",
  "$defs": {
    "DeterminismCheck": {
      "additionalProperties": false,
      "description": "Outcome of running the master script twice and comparing outputs/results.json and produced output files.",
      "properties": {
        "runs": {
          "minimum": 2,
          "title": "Runs",
          "type": "integer"
        },
        "status": {
          "enum": [
            "identical",
            "numerically_close",
            "different",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "run1_results_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run1 Results Sha256"
        },
        "run2_results_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run2 Results Sha256"
        },
        "differences": {
          "items": {
            "$ref": "#/$defs/DeterminismDiff"
          },
          "title": "Differences",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "runs",
        "status",
        "summary"
      ],
      "title": "DeterminismCheck",
      "type": "object"
    },
    "DeterminismDiff": {
      "additionalProperties": false,
      "description": "One difference observed between two consecutive runs of the master script.",
      "properties": {
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "target id in outputs/results.json, if applicable",
          "title": "Target"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "package-relative output file path, if applicable",
          "title": "Path"
        },
        "kind": {
          "enum": [
            "missing_in_run",
            "value_changed",
            "table_changed",
            "file_changed",
            "parse_error"
          ],
          "title": "Kind",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "max_rel_diff": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "largest relative numeric change between runs, if numeric",
          "title": "Max Rel Diff"
        },
        "looks_like_clock": {
          "default": false,
          "description": "heuristic: the difference looks like a clock/timestamp reading",
          "title": "Looks Like Clock",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "detail"
      ],
      "title": "DeterminismDiff",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "description": "Points at one sentence, figure or table of an extraction.",
      "properties": {
        "extraction": {
          "description": "resource name of the extraction, e.g. ex-grobid",
          "title": "Extraction",
          "type": "string"
        },
        "id": {
          "description": "sentence (sec3.p2.s1, fig1.s1), figure (fig1) or table (tab1) id in that extraction",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "extraction",
        "id"
      ],
      "title": "Ref",
      "type": "object"
    },
    "RunIsolation": {
      "additionalProperties": false,
      "description": "Clean-room settings applied to the script run (honest record, not an OS container).",
      "properties": {
        "network_denied_by": {
          "description": "how network access was denied: Linux network namespace, macOS sandbox-exec, or dead-proxy env vars only",
          "enum": [
            "namespace",
            "sandbox",
            "proxy"
          ],
          "title": "Network Denied By",
          "type": "string"
        },
        "clean_home": {
          "default": true,
          "description": "private empty HOME/TMPDIR and scratch R library (user libraries stay readable)",
          "title": "Clean Home",
          "type": "boolean"
        },
        "tz": {
          "default": "UTC",
          "title": "Tz",
          "type": "string"
        },
        "locale": {
          "default": "C.UTF-8",
          "title": "Locale",
          "type": "string"
        },
        "runtime_caches": {
          "description": "runtime cache files left behind in the package by the run",
          "items": {
            "type": "string"
          },
          "title": "Runtime Caches",
          "type": "array"
        }
      },
      "required": [
        "network_denied_by"
      ],
      "title": "RunIsolation",
      "type": "object"
    },
    "TargetEvidence": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "title": "Target",
          "type": "string"
        },
        "refs": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Refs",
          "type": "array"
        },
        "step": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        },
        "step_evidence": {
          "enum": [
            "declared_matches_plan",
            "declared_conflicts_plan",
            "declared_unchecked",
            "planned_only",
            "none"
          ],
          "title": "Step Evidence",
          "type": "string"
        },
        "level": {
          "const": "process",
          "default": "process",
          "title": "Level",
          "type": "string"
        }
      },
      "required": [
        "target",
        "refs",
        "step_evidence"
      ],
      "title": "TargetEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "track": {
      "anyOf": [
        {
          "const": "recreation",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Track"
    },
    "run": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run"
    },
    "stale": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stale"
    },
    "stale_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stale Reason"
    },
    "added_since_run": {
      "items": {
        "type": "string"
      },
      "title": "Added Since Run",
      "type": "array"
    },
    "stale_hashes": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "description": "current hash of each stale or added file (null if deleted), so a later edit to an already stale file is detected",
      "title": "Stale Hashes",
      "type": "object"
    },
    "results_match_run": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Results Match Run"
    },
    "determinism": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeterminismCheck"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "two-run determinism check recorded by the latest run, if run twice"
    },
    "isolation": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunIsolation"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "clean-room isolation recorded by the latest run"
    },
    "codegen": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Codegen"
    },
    "targets": {
      "items": {
        "$ref": "#/$defs/TargetEvidence"
      },
      "title": "Targets",
      "type": "array"
    },
    "log_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Log Path"
    },
    "log_truncated": {
      "default": false,
      "title": "Log Truncated",
      "type": "boolean"
    },
    "log_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Log Sha256"
    }
  },
  "type": "object"
}
