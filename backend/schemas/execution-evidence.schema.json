{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reprocrowd.example/schemas/execution-evidence.schema.json",
  "title": "ExecutionEvidence (evidence/execution.json)",
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "description": "Points at one sentence, figure or table of an extraction.",
      "properties": {
        "extraction": {
          "description": "resource name of the extraction, e.g. ex-grobid",
          "title": "Extraction",
          "type": "string"
        },
        "id": {
          "description": "sentence (sec3.p2.s1, fig1.s1), figure (fig1) or table (tab1) id in that extraction",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "extraction",
        "id"
      ],
      "title": "Ref",
      "type": "object"
    },
    "TargetEvidence": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "title": "Target",
          "type": "string"
        },
        "refs": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Refs",
          "type": "array"
        },
        "step": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        },
        "step_evidence": {
          "enum": [
            "declared_matches_plan",
            "declared_conflicts_plan",
            "planned_only",
            "none"
          ],
          "title": "Step Evidence",
          "type": "string"
        },
        "level": {
          "const": "process",
          "default": "process",
          "title": "Level",
          "type": "string"
        }
      },
      "required": [
        "target",
        "refs",
        "step_evidence"
      ],
      "title": "TargetEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "track": {
      "anyOf": [
        {
          "const": "recreation",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Track"
    },
    "run": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run"
    },
    "stale": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stale"
    },
    "stale_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stale Reason"
    },
    "added_since_run": {
      "items": {
        "type": "string"
      },
      "title": "Added Since Run",
      "type": "array"
    },
    "results_match_run": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Results Match Run"
    },
    "codegen": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Codegen"
    },
    "targets": {
      "items": {
        "$ref": "#/$defs/TargetEvidence"
      },
      "title": "Targets",
      "type": "array"
    },
    "log_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Log Path"
    },
    "log_truncated": {
      "default": false,
      "title": "Log Truncated",
      "type": "boolean"
    },
    "log_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Log Sha256"
    }
  },
  "type": "object"
}
